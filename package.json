{
  "name": "framer-export",
  "version": "5.0.1",
  "description": "Export public pages from 25 website platforms into local HTML, CSS and assets. Captures dynamic styles, responsive resources and reusable scripts, with diagnostics for incomplete exports.",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "framer-export": "bin/framer-export.js",
    "fexport": "bin/fexport.js",
    "framerexport": "bin/framerexport.js"
  },
  "files": [
    "dist/",
    "bin/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "assets/provider-icons/SOURCES.md"
  ],
  "scripts": {
    "start": "tsx src/cli/index.ts",
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:browser": "node --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:platform": "node --import tsx scripts/validate-platform.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:browser",
    "release": "node scripts/release.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "framer",
    "webflow",
    "wix",
    "shopify",
    "notion",
    "wordpress",
    "squarespace",
    "ghost",
    "carrd",
    "bubble",
    "gumroad",
    "exporter",
    "export",
    "scraper",
    "mirror",
    "site-downloader",
    "site-export",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbenba/FramerExport.git"
  },
  "homepage": "https://github.com/danbenba/FramerExport#readme",
  "bugs": {
    "url": "https://github.com/danbenba/FramerExport/issues"
  },
  "license": "MIT",
  "author": "Dany (danbenba)",
  "publishConfig": {
    "tag": "latest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "prettier": "^3.2.0",
    "puppeteer": "^24.43.1",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
